# ============================================================
# ToolsBar v2 — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Site ─────────────────────────────────────────────────────
# The public origin of this deployment. It drives canonical URLs, Open Graph
# URLs, JSON-LD structured data, robots.txt and the sitemap.
#
#   • On Vercel this is OPTIONAL — the real deployed URL is auto-detected
#     (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL) when this is unset.
#   • Set it explicitly once you have a custom domain, and on any host that
#     is not Vercel. Use a full origin with scheme, no path, no trailing
#     slash, e.g. https://example.com
#   • Local development needs nothing: it defaults to http://localhost:3000.
#   • Leave it COMMENTED OUT unless you mean it — a value copied from here
#     into .env.local would override auto-detection with the wrong domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── Database (Supabase PostgreSQL) ───────────────────────────
# DATABASE_URL = the *pooled* connection (Supavisor, transaction mode, port 6543).
#   Supabase dashboard → Connect → Transaction pooler. Keep ?pgbouncer=true.
# DIRECT_URL   = the *direct* connection (port 5432), used only by Prisma
#   migrations / `db push`.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ── Supabase (file storage for blog images) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Admin Auth ───────────────────────────────────────────────
NEXTAUTH_SECRET=your-very-long-random-secret-here-minimum-32-chars
ADMIN_INITIAL_PASSWORD=ChangeMe@2025!

# ── URL Shortener (Cloudflare Worker) ────────────────────────
# Your existing worker — only used by the URL Shortener tool.
URL_SHORTENER_WORKER_URL=https://url.kazirajibulislam567567.workers.dev

# ── PDF Split ─────────────────────────────────────────────────
# PDF Split runs in the browser first (qpdf WebAssembly + pdf-lib + pdf.js).
# OPTIONAL server fallback, offered to the user only after they consent, for
# PDFs the browser cannot handle (e.g. out of memory). It needs the Supabase
# variables above (NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY): the browser uploads straight to a PRIVATE
# bucket (Vercel caps request/response bodies at 4.5 MB, so files can't go
# through a function). Leave the service-role key unset to disable the fallback.
# Bucket name (auto-created, private, 50 MB limit). Default: pdf-split-temp
# PDF_SPLIT_BUCKET=pdf-split-temp

# ── Google AdSense (add after approval) ──────────────────────
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_AD_SLOT_HOME_HERO=XXXXXXXXXX
NEXT_PUBLIC_AD_SLOT_HOME_MID=XXXXXXXXXX
NEXT_PUBLIC_AD_SLOT_TOOL_BELOW=XXXXXXXXXX
NEXT_PUBLIC_AD_SLOT_BLOG_SIDEBAR=XXXXXXXXXX
NEXT_PUBLIC_AD_SLOT_BLOG_CONTENT=XXXXXXXXXX

# ── Contact Form (Formspree) ─────────────────────────────────
NEXT_PUBLIC_FORMSPREE_ID=your-formspree-form-id

# ── Analytics (optional) ─────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
